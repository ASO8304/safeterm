[
  {
    "name": "system_info",
    "description": "Show basic host information (hostname, kernel, OS).",
    "runner_profile": "diagnostics",
    "executor_kind": "process",
    "executable_ref": "uname",
    "args_template": ["-a"],
    "parameters": [],
    "long_running": false
  },
  {
    "name": "trace",
    "description": "Capture live traffic; host or port must be specified. Protocol is optional.",
    "runner_profile": "network-observer",
    "executor_kind": "process",
    "executable_ref": "tcpdump",
    "args_template": ["-l", "-nn", "-i", "any"],
    "required_any": ["host", "port"],
    "argument_group_separator": ["and"],
    "argument_groups": [
      { "when": "port", "args_template": ["port", "{port}"] },
      { "when": "host", "args_template": ["host", "{host}"] },
      { "when": "protocol", "args_template": ["{protocol}"] }
    ],
    "parameters": [
      { "name": "host", "type": "string", "required": false, "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}$" },
      { "name": "port", "type": "int", "required": false, "min": 1, "max": 65535 },
      { "name": "protocol", "type": "string", "required": false, "value_map": { "tcp": "tcp", "udp": "udp", "icmp": "icmp", "arp": "arp", "ip": "ip" } }
    ],
    "long_running": true
  },
  {
    "name": "ping",
    "description": "Send bounded ICMP echo requests with live output; default and maximum count 1000.",
    "runner_profile": "network-observer",
    "executor_kind": "process",
    "executable_ref": "ping",
    "args_template": ["-n", "-4", "-c", "{count}", "-W", "2", "--", "{host}"],
    "parameters": [
      {
        "name": "host",
        "type": "string",
        "required": true,
        "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}$"
      },
      {
        "name": "count",
        "type": "int",
        "required": false,
        "default": "1000",
        "aliases": ["-c"],
        "min": 1,
        "max": 1000
      }
    ],
    "long_running": true
  },
  {
    "name": "log",
    "description": "Follow an approved service log. Press Ctrl+C to stop.",
    "runner_profile": "log-reader",
    "executor_kind": "process",
    "executable_ref": "tail",
    "args_template": ["-n", "50", "-F", "--", "{source}"],
    "parameters": [
      {
        "name": "source",
        "type": "string",
        "required": true,
        "value_map": {
          "service_A": "/var/log/safeterm-readable/service_A.log",
          "system": "/var/log/syslog",
          "authentication": "/var/log/auth.log"
        }
      }
    ],
    "long_running": true
  },
  {
    "name": "nslookup",
    "description": "Resolve an approved hostname or IPv4 address.",
    "runner_profile": "network-observer",
    "executor_kind": "process",
    "executable_ref": "nslookup",
    "args_template": ["{host}"],
    "parameters": [{ "name": "host", "type": "string", "required": true, "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{0,252}$" }],
    "long_running": false
  },
  {
    "name": "traceroute",
    "description": "Trace the route to an approved hostname or IPv4 address.",
    "runner_profile": "network-observer",
    "executor_kind": "process",
    "executable_ref": "traceroute",
    "args_template": ["-n", "-m", "12", "-w", "2", "{host}"],
    "parameters": [{ "name": "host", "type": "string", "required": true, "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]{0,252}$" }],
    "long_running": true
  },
  {
    "name": "memory_info",
    "description": "Show human-readable memory usage.",
    "runner_profile": "diagnostics",
    "executor_kind": "process",
    "executable_ref": "free",
    "args_template": ["-h"],
    "parameters": [],
    "long_running": false
  },
  {
    "name": "disk_usage",
    "description": "Show human-readable usage for the root filesystem.",
    "runner_profile": "diagnostics",
    "executor_kind": "process",
    "executable_ref": "df",
    "args_template": ["-h", "/"],
    "parameters": [],
    "long_running": false
  },
