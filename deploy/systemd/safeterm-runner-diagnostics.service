[Unit]
Description=SafeTerm diagnostics runner
Requires=safeterm-audit.service
After=local-fs.target safeterm-audit.service

[Service]
Type=simple
User=safeterm-diagnostics
Group=safeterm-gateway
SupplementaryGroups=safeterm-audit
RuntimeDirectory=safeterm-diagnostics
RuntimeDirectoryMode=0750
ExecStart=/usr/local/bin/safeterm-runner --config /etc/safeterm --profile diagnostics --timeout 30s --output-limit 1048576 --stream-chunk 16384 --stream-queue 64 --stream-max-sessions 64 --stream-idle-timeout 5m --interrupt-grace 2s --terminate-grace 2s
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
MemoryMax=128M
TasksMax=32

[Install]
WantedBy=multi-user.target
