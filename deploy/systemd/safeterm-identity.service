[Unit]
Description=SafeTerm internal Console identity and sessions
Requires=safeterm-audit.service
After=safeterm-audit.service
Before=safeterm-gateway.service safeterm-config-manager-application.service safeterm-config-manager-database.service safeterm-config-manager-network.service

[Service]
Type=simple
User=safeterm-identity
Group=safeterm-clients
SupplementaryGroups=safeterm-audit safeterm-identity
RuntimeDirectory=safeterm-identity
RuntimeDirectoryMode=0750
UMask=0007
ExecStart=/usr/local/bin/safeterm-identity --config /var/lib/safeterm/generated --session-ttl 30m
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
MemoryMax=96M
TasksMax=32
LimitNOFILE=128
LimitCORE=0
ProtectProc=invisible
ProcSubset=pid
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
