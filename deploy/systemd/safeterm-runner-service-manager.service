[Unit]
Description=SafeTerm service manager runner
Requires=safeterm-audit.service
After=dbus.service safeterm-audit.service

[Service]
Type=simple
User=safeterm-service-manager
Group=safeterm-gateway
SupplementaryGroups=safeterm-audit
RuntimeDirectory=safeterm-service-manager
RuntimeDirectoryMode=0750
ExecStart=/usr/local/bin/safeterm-runner --config /var/lib/safeterm/generated --profile service-manager --timeout 30s --output-limit 1048576 --stream-chunk 16384 --stream-queue 64 --stream-max-sessions 64 --stream-idle-timeout 5m --interrupt-grace 2s --terminate-grace 2s
NoNewPrivileges=no
CapabilityBoundingSet=CAP_SETUID CAP_SETGID CAP_AUDIT_WRITE
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictSUIDSGID=no
LockPersonality=yes
MemoryDenyWriteExecute=yes
MemoryMax=128M
TasksMax=16

[Install]
WantedBy=multi-user.target
