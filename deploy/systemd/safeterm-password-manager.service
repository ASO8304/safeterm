[Unit]
Description=SafeTerm self-service password changes
After=local-fs.target safeterm-audit.service safeterm-identity.service
Requires=safeterm-audit.service safeterm-identity.service
Before=safeterm-ssh-broker.service

[Service]
Type=simple
User=root
Group=safeterm-clients
SupplementaryGroups=safeterm-audit
RuntimeDirectory=safeterm-password-manager
RuntimeDirectoryMode=0750
UMask=0077
ExecStart=/usr/local/bin/safeterm-password-manager
Restart=on-failure
RestartSec=2s
# The root-only child retains existing effective privileges and sets its real
# UID to the operator; passwd/PAM require the operator's current password.
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_SETUID CAP_SETGID CAP_AUDIT_WRITE
AmbientCapabilities=
ProtectSystem=strict
ReadWritePaths=/etc
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
MemoryMax=128M
TasksMax=32
LimitNOFILE=64
LimitCORE=0
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
