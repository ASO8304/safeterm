[Unit]
Description=SafeTerm restricted Netplan network manager
After=network.target safeterm-audit.service safeterm-identity.service
Requires=safeterm-audit.service safeterm-identity.service

[Service]
Type=simple
User=root
Group=safeterm-clients
SupplementaryGroups=safeterm-audit
RuntimeDirectory=safeterm-network-manager
RuntimeDirectoryMode=0750
UMask=0077
ExecStart=/usr/local/bin/safeterm-network-manager
Restart=on-failure
RestartSec=3s
TimeoutStopSec=180s
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_CHOWN CAP_FOWNER
AmbientCapabilities=
ProtectSystem=strict
ReadWritePaths=/run /var/lib/safeterm
ReadWritePaths=-/etc/netplan
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryMax=256M
TasksMax=64
LimitNOFILE=128
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
