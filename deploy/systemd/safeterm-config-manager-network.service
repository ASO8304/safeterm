[Unit]
Description=SafeTerm network Config Manager
After=safeterm-identity.service local-fs.target safeterm-audit.service
Requires=safeterm-audit.service safeterm-identity.service
Before=safeterm-ssh-broker.service

[Service]
Type=simple
User=safeterm-config-network
Group=safeterm-clients
SupplementaryGroups=safeterm-audit safeterm-gateway safeterm-config-network
RuntimeDirectory=safeterm-config-network
RuntimeDirectoryMode=0750
UMask=0007
ExecStart=/usr/local/bin/safeterm-config-manager -profile=network -run-as-user=safeterm-config-network -registry=/etc/safeterm/config-manager/resources.json -socket=/run/safeterm-config-network/manager.sock
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ReadWritePaths=/etc/safeterm-managed/network
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
MemoryMax=96M
TasksMax=32
LimitNOFILE=128
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target

