[Unit]
Description=SafeTerm database Config Manager
After=safeterm-config-writer.service safeterm-identity.service local-fs.target safeterm-audit.service
Requires=safeterm-config-writer.service safeterm-audit.service safeterm-identity.service
Before=safeterm-ssh-broker.service

[Service]
Type=simple
User=safeterm-config-database
Group=safeterm-clients
SupplementaryGroups=safeterm-audit safeterm-config-writers safeterm-gateway safeterm-config-database
RuntimeDirectory=safeterm-config-database
RuntimeDirectoryMode=0750
UMask=0007
ExecStart=/usr/local/bin/safeterm-config-manager -profile=database -run-as-user=safeterm-config-database -registry=/var/lib/safeterm/generated/resources.json -socket=/run/safeterm-config-database/manager.sock
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
MemoryMax=96M
TasksMax=32
LimitNOFILE=128
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target

