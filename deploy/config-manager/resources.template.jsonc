// Copy this file to a new .json file in the installed config-manager registry
// directory. Runtime loaders ignore .jsonc files, so this guide is never active.
// Keep only the fields that apply to your resource, then validate the complete
// deployment with: sudo /usr/local/bin/safeterm-preflight --installed
{
  "version": "config-resources-v1",
  "resources": [
    {
      // Stable identifier shown by `config list` and used by all config commands.
      "id": "service-options",
      "description": "Human-readable purpose of this managed file",

      // Selects the isolated config-manager service: application, database, or network.
      "profile": "application",
      "path": "/etc/example/service.ini",
      // Supported formats: ini or json.
      "format": "ini",
      // Supported access modes: read-only or read-write.
      "access": "read-write",

      "fields": [
        {
          // For JSON, section identifies the top-level object. For INI, it is
          // the section name. Every editable value must be declared explicitly.
          "section": "server",
          "key": "listen_port",
          // Types: string, integer, boolean, enum, or path.
          "type": "integer",
          "required": true,
          "secret": false,
          "read_only": false,
          // integer only:
          "min": 1,
          "max": 65535
        },
        {
          "section": "server",
          "key": "mode",
          "type": "enum",
          "required": true,
          "secret": false,
          "read_only": false,
          // enum only:
          "enum": ["development", "production"]
        },
        {
          "section": "server",
          "key": "api_token",
          "type": "string",
          "required": true,
          // Secret values are accepted but never returned in clear text.
          "secret": true,
          "read_only": false,
          // string only:
          "min_length": 16,
          "max_length": 256,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        {
          "section": "storage",
          "key": "data_directory",
          "type": "path",
          "required": true,
          "secret": false,
          "read_only": false,
          // path only. file_type is file or directory; expected_uid is numeric.
          "path": {
            "allowed_prefixes": ["/srv/example"],
            "must_exist": true,
            "file_type": "directory",
            "allow_symlink": false,
            "expected_uid": 0,
            "expected_mode": "0750"
          }
        },
        {
          "section": "features",
          "key": "enabled",
          "type": "boolean",
          "required": true,
          "secret": false,
          "read_only": false
        },
        {
          "section": "limits",
          "key": "minimum",
          "type": "integer",
          "required": true,
          "secret": false,
          "read_only": false,
          "min": 0,
          "max": 1000
        },
        {
          "section": "limits",
          "key": "maximum",
          "type": "integer",
          "required": true,
          "secret": false,
          "read_only": false,
          "min": 0,
          "max": 1000
        }
      ],

      // Optional cross-field rules. Supported types: not_equal and
      // less_or_equal. Remove the array when unused.
      "cross_field_rules": [
        {
          "type": "less_or_equal",
          "section": "limits",
          "key": "minimum",
          "other_section": "limits",
          "other_key": "maximum"
        }
      ],

      // Optional external validator name registered by the config manager.
      // "validator_id": "registered-validator-name",
      // Optional safe catalog operations run after apply and for health check.
      // Both names must exist in the signed operation catalog.
      "activation_operation": "restart_service",
      "health_check_operation": "check_service",
      "rollback_on_failure": true,

      // false lets the proposer apply their own proposal when their role is
      // also listed in apply_roles. true enforces a second user.
      "require_separate_approval": false,
      "backup": {
        "enabled": true,
        "keep": 5
      },
      "permissions": {
        "read_roles": ["config-viewer", "config-operator"],
        "propose_roles": ["config-operator"],
        "apply_roles": ["config-operator"],
        "activate_roles": ["config-operator"],
        "rollback_roles": ["config-operator"]
      }
    }
  ]
}
