// Internal Console users do not need Linux accounts. Provision through:
// sudo termctl user add console --id alice --roles viewer,netops
// Or supply a bcrypt hash and set disabled=false here. Do not use a plaintext
// password. The shared Linux safeterm account has no read access to this file.
{
  "users": [
    {
      "user_id": "local-operator",
      "roles": ["viewer", "log-viewer", "service-viewer"],
      "disabled": true
    }
  ]
}
