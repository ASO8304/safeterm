[
  {
    "name": "system_info",
    "description": "Show basic host information (hostname, kernel, OS).",
    "runner_profile": "diagnostics",
    "executor_kind": "process",
    "executable_ref": "uname",
    "args_template": ["-a"],
    "parameters": [],
    "long_running": false
  },
  {
    "name": "trace",
    "description": "Capture network traffic for a specific host and port. Long-running; streamed to the caller.",
    "runner_profile": "network-observer",
    "executor_kind": "process",
    "executable_ref": "tcpdump",
    "args_template": ["-i", "any", "port", "{port}", "and", "host", "{host}"],
    "parameters": [
      { "name": "port", "type": "int", "required": true, "min": 1, "max": 65535 },
      { "name": "host", "type": "string", "required": true, "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}$" }
    ],
    "long_running": true
  }
]
