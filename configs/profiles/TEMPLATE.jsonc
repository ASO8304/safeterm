[
  {
    "name": "example-reader",
    "executor_kind": "process",
    "socket_path": "/run/safeterm-example/runner.sock",
    "run_as_user": "safeterm-example",
    "capabilities": [],                        // e.g. CAP_NET_RAW; CAP_SYS_ADMIN is rejected
    "memory_limit_mib": 128,
    "process_limit": 16
  },
  {
    "name": "service-manager",
    "executor_kind": "systemd",
    "controller_executable_ref": "sudo",
    // Privileged mode is intentionally restricted to this exact prefix.
    "controller_args_prefix": ["-n", "/usr/bin/systemctl", "--no-pager"],
    "socket_path": "/run/safeterm-service-manager/runner.sock",
    "run_as_user": "safeterm-service-manager",
    "capabilities": [],
    "memory_limit_mib": 128,
    "process_limit": 16
  }
]
