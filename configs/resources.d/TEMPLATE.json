{
  "id": "example",
  "description": "Example application: copy this file, remove unused sections and edit paths",
  "service": {
    "unit": "example.service",
    "actions": {
      "status": {
        "roles": [
          "service-viewer",
          "service-operator"
        ]
      },
      "restart": {
        "roles": [
          "service-operator"
        ]
      },
      "start": {
        "roles": [
          "service-operator"
        ]
      },
      "stop": {
        "roles": [
          "service-operator"
        ]
      },
      "enable": {
        "roles": [
          "service-operator"
        ]
      },
      "disable": {
        "roles": [
          "service-operator"
        ]
      }
    }
  },
  "config": {
    "path": "/etc/example/options.ini",
    "format": "ini",
    "backup_keep": 5,
    "permissions": {
      "read": [
        "config-viewer",
        "config-operator"
      ],
      "edit": [
        "config-operator"
      ],
      "rollback": [
        "config-operator"
      ]
    },
    "contexts": [
      {
        "path": [
          "application",
          "example"
        ],
        "description": "Example application settings",
        "fields": [
          {
            "name": "listen-port",
            "section": "Server",
            "key": "Port",
            "description": "Listening port",
            "type": "port",
            "required": true
          },
          {
            "name": "listen-address",
            "section": "Server",
            "key": "ListenAddress",
            "description": "IPv4 address (adapt field names to the real file)",
            "type": "ipv4",
            "required": true,
            "allow_empty": false
          }
        ]
      }
    ]
  },
  "logs": [
    {
      "id": "main",
      "description": "Main application log",
      "path": "/var/log/example/application.log",
      "roles": [
        "log-viewer"
      ]
    }
  ]
}
