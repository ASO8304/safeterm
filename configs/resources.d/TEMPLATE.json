{
  "id": "example",
  "description": "Example application: copy this file, remove unused sections and edit paths",
  "service": {
    "unit": "example.service",
    "actions": {
      "status": { "roles": ["service-viewer", "service-operator"] },
      "restart": { "roles": ["service-operator"] },
      "start": { "roles": ["service-operator"] },
      "stop": { "roles": ["service-operator"] },
      "enable": { "roles": ["service-operator"] },
      "disable": { "roles": ["service-operator"] }
    }
  },
  "config": {
    "path": "/etc/example/options.ini",
    "format": "ini",
    "backup_keep": 5,
    "permissions": {
      "read": ["config-viewer", "config-operator"],
      "edit": ["config-operator"],
      "rollback": ["config-operator"]
    },
    "fields": [
      {
        "section": "Server",
        "key": "Port",
        "description": "Listening port",
        "type": "integer",
        "required": true,
        "min": 1,
        "max": 65535
      }
    ]
  },
  "logs": [
    {
      "id": "main",
      "description": "Main application log",
      "path": "/var/log/example/application.log",
      "roles": ["log-viewer"]
    }
  ]
}
